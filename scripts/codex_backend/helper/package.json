{
  "name": "codex-backend",
  "displayName": "Codex Backend Connector",
  "description": "Connect the official Codex sidebar to a persistent Slurm backend.",
  "publisher": "mdlammps",
  "version": "0.1.0",
  "engines": { "vscode": "^1.104.0" },
  "main": "./extension.cjs",
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished", "onUri"],
  "extensionDependencies": ["openai.chatgpt"],
  "contributes": { "commands": [
    { "command": "mdlammps.codexBackend.restore", "title": "Codex Backend: Restore Previous CLI Setting" }
  ] }
}
